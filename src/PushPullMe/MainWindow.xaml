<Window x:Class="PushPullMe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="PushPullMe" Icon="Assets/pushpullme.ico" Height="860" Width="1320" Background="{StaticResource Page}"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown" TextInput="Window_TextInput">
    <Window.Resources>
        <!-- tool buttons: round squares in the toolbar, four to a row; grey when not there yet -->
        <ControlTemplate x:Key="ToolFace" TargetType="ButtonBase">
            <Border x:Name="B" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="11">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="B" Property="Background" Value="{StaticResource AccentGradient}"/>
                    <Setter TargetName="B" Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="B" Property="Background" Value="#F1F3F7"/>
                    <Setter TargetName="B" Property="BorderBrush" Value="#E2E6EE"/>
                    <Setter Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Tool" TargetType="RadioButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Tools"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template" Value="{StaticResource ToolFace}"/>
        </Style>
        <Style x:Key="ToolAction" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template" Value="{StaticResource ToolFace}"/>
        </Style>
        <!-- not there yet: grey, its tooltip says so -->
        <Style x:Key="NotYet" TargetType="RadioButton" BasedOn="{StaticResource Tool}">
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <Style x:Key="ToolGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="2,2,0,3"/>
            <Setter Property="Width" Value="215"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== top bar: name and file buttons -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/pushpullme.png" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="PushPullMe" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentGradient}"/>
                <TextBlock x:Name="FileText" Text="" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="14,0,0,4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="LanguageButton" Content="🌐  NL" Style="{StaticResource PillButton}" Click="Language_Click" ToolTip="Taal / language: Nederlands · English"/>
                <Button x:Name="UndoButton" Content="↩  ongedaan" Style="{StaticResource PillButton}" Click="Undo_Click" IsEnabled="False" ToolTip="Ctrl+Z"/>
                <Button x:Name="RedoButton" Content="↪  opnieuw" Style="{StaticResource PillButton}" Click="Redo_Click" IsEnabled="False" ToolTip="Ctrl+Y"/>
                <Button Content="📂  openen" Style="{StaticResource PillButton}" Click="Open_Click" ToolTip="STL, 3MF of .rsdocx (Ctrl+O)"/>
                <Button x:Name="SaveButton" Content="💾  opslaan" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="False"
                        ToolTip="Als .rsdocx (voor je tekenpakket) of .stl (voor de printer) (Ctrl+S)" Margin="0,0,0,8"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================== toolbar, and under it the structure tree (when it is on the left) -->
        <Grid x:Name="LeftColumn" Grid.Row="1" Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="10,10,4,4" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel Width="215">
                <TextBlock Style="{StaticResource ToolGroup}" Text="BASIS"/>
                <RadioButton x:Name="SelectTool" Style="{StaticResource Tool}" Content="↖" Checked="Tool_Checked" IsChecked="True"
                             ToolTip="Selecteren (spatie)"/>
                <RadioButton x:Name="PushTool" Style="{StaticResource Tool}" Content="⇕" Checked="Tool_Checked"
                             ToolTip="Push/Pull (P): klik een plat vlak, beweeg, klik nog eens. Of typ de afstand + Enter."/>
                <RadioButton x:Name="MoveTool" Style="{StaticResource Tool}" Content="✥" Checked="Tool_Checked"
                             ToolTip="Verplaatsen (M): klik een hoekpunt, rand of vlak, beweeg en klik nog eens; wat eraan vastzit buigt mee. Shift: het hele lichaam · Ctrl: een kopie van het lichaam. Pijltjes: rood, groen of blauwe as. Of typ de afstand + Enter."/>
                <RadioButton x:Name="RotateTool" Style="{StaticResource Tool}" Content="↻" Checked="Tool_Checked"
                             ToolTip="Draaien (Q): klik bij een rand van een vlak om dat vlak om die rand te kantelen; klik midden op een vlak voor het draaipunt van het hele lichaam (de as staat er haaks op; pijltjes: rode, groene of blauwe as), klik de beginrichting, beweeg (stappen van 15°) en klik. Of typ de hoek + Enter. Ctrl bij de eerste klik: een gedraaide kopie."/>
                <RadioButton x:Name="ScaleTool" Style="{StaticResource Tool}" Content="⇲" Checked="Tool_Checked"
                             ToolTip="Schalen (S): klik het punt dat blijft staan, klik het punt waaraan je trekt, beweeg en klik; of typ de factor (bv. 1,5) + Enter. Pijltjes: alleen langs de rode, groene of blauwe as (bij platte vlakken). Ctrl bij de eerste klik: een geschaalde kopie."/>
                <TextBlock Style="{StaticResource ToolGroup}" Text="TEKENEN"/>
                <RadioButton x:Name="LineTool" Style="{StaticResource Tool}" Content="╱" Checked="Tool_Checked"
                             ToolTip="Lijn (L): klik punt na punt op een plat vlak (vastklikken op assen, evenwijdig en loodrecht aan randen, eindpunten, middens en hulplijnen). Terug op het beginpunt: een eigen vlak; van rand tot rand: het vlak wordt gedeeld. Typ een lengte + Enter."/>
                <RadioButton x:Name="RectTool" Style="{StaticResource Tool}" Content="▭" Checked="Tool_Checked"
                             ToolTip="Rechthoek (R): klik een hoek op een plat vlak, klik de andere hoek. Of typ breedte;hoogte + Enter."/>
                <RadioButton x:Name="CircleTool" Style="{StaticResource Tool}" Content="◯" Checked="Tool_Checked"
                             ToolTip="Cirkel (C): klik het middelpunt op een plat vlak en dan de rand. Of typ de straal + Enter."/>
                <RadioButton x:Name="RotRectTool" Style="{StaticResource Tool}" Content="◇" Checked="Tool_Checked"
                             ToolTip="Rechthoek onder een hoek: klik een hoek, klik de tweede hoek (de eerste zijde, in elke richting), beweeg voor de breedte en klik; of typ de breedte + Enter."/>
                <RadioButton x:Name="PolygonTool" Style="{StaticResource Tool}" Content="⬡" Checked="Tool_Checked"
                             ToolTip="Veelhoek (G): klik het middelpunt op een plat vlak, beweeg (grootte en stand) en klik; of typ de straal + Enter. ↑/↓: meer of minder hoeken (standaard 6)."/>
                <RadioButton x:Name="CentreArcTool" Style="{StaticResource Tool}" Content="◜" Checked="Tool_Checked"
                             ToolTip="Boog vanaf het middelpunt: klik het middelpunt, klik het beginpunt (de straal), beweeg voor de hoek (stappen van 15°) en klik; of typ de hoek + Enter. Van rand tot rand deelt hij het vlak, anders een losse boog (die met lijnen of randen een vlak kan sluiten)."/>
                <RadioButton x:Name="ArcTool" Style="{StaticResource Tool}" Content="⌒" Checked="Tool_Checked"
                             ToolTip="Boog (A): klik het beginpunt, het eindpunt, en beweeg voor de bolling; klik, of typ de bolling + Enter. Van rand tot rand deelt hij het vlak (een hoek afronden), anders een losse boog (die met lijnen of randen een vlak kan sluiten)."/>
                <RadioButton x:Name="Arc3Tool" Style="{StaticResource Tool}" Content="⌓" Checked="Tool_Checked"
                             ToolTip="Boog door drie punten: klik het beginpunt, een punt waar de boog doorheen gaat, en het eindpunt (vastklikken op hoeken, middens en randen). Van rand tot rand deelt hij het vlak, anders een losse boog (die met lijnen of randen een vlak kan sluiten)."/>
                <RadioButton x:Name="PieTool" Style="{StaticResource Tool}" Content="◔" Checked="Tool_Checked"
                             ToolTip="Taartpunt: klik het middelpunt, klik het beginpunt (de straal), beweeg voor de hoek (stappen van 15°) en klik; of typ de hoek + Enter. Wordt een vlak (boog + twee stralen) om eruit te trekken."/>
                <RadioButton x:Name="FreehandTool" Style="{StaticResource Tool}" Content="✎" Checked="Tool_Checked"
                             ToolTip="Uit de vrije hand (Freehand): klik op een plat vlak om te beginnen, beweeg (het spoor wordt gevolgd) en klik om te eindigen. Terug bij het begin: een vlak; anders losse lijnen (die met andere lijnen of randen een vlak kunnen sluiten)."/>
                <RadioButton x:Name="WorkPlaneTool" Style="{StaticResource Tool}" Content="⊞" Checked="Tool_Checked"
                             ToolTip="Werkvlak: waar je tekent als er geen vlak onder de muis is (eerst de grond, met het raster). Klik een plat vlak: het werkvlak ligt er gelijk mee; klik leeg: weer op de grond. Pijltjes: draaien (15°, Shift 5°); typ mm + Enter: verschuiven langs de normaal (x;y: in het vlak)."/>
                <TextBlock Style="{StaticResource ToolGroup}" Text="BEWERKEN"/>
                <RadioButton x:Name="OffsetTool" Style="{StaticResource Tool}" Content="▣" Checked="Tool_Checked"
                             ToolTip="Offset (F): klik een plat vlak en beweeg naar binnen: een nieuwe rand op vaste afstand van de buitenrand (voor een wand of kraag); beweeg naar buiten voor een rand eromheen (op het vlak eromheen). Of typ de afstand + Enter (min: naar buiten)."/>
                <RadioButton x:Name="RoundTool" Style="{StaticResource Tool}" Content="◠" Checked="Tool_Checked"
                             ToolTip="Afronden (K): klik een scherpe rechte rand tussen twee platte vlakken en beweeg voor de straal; klik, of typ de straal + Enter. (Zoals DesignSpark; in SketchUp zit dit niet.)"/>
                <RadioButton x:Name="FollowTool" Style="{StaticResource Tool}" Content="↝" Checked="Tool_Checked"
                             ToolTip="Ronddraaien en volgen (Follow Me): klik een plat vlak (het profiel), en dan een as (een rechte rand, losse lijn of hulplijn in dat vlak) om het rond te draaien – beweeg voor de hoek (stappen van 15°, of 360°) en klik, of typ de hoek + Enter – of een vlak waarvan de rand het pad is: het profiel loopt die rand rond (in het lichaam: weggesneden, zoals een afschuining; erbuiten: een lijst)."/>
                <RadioButton x:Name="MirrorTool" Style="{StaticResource Tool}" Content="⇋" Checked="Tool_Checked"
                             ToolTip="Spiegelen: klik een plat vlak; het lichaam spiegelt in dat vlak naar de andere kant. Ctrl+klik: een gespiegelde kopie erbij (twee helften van een symmetrisch onderdeel)."/>
                <Button x:Name="OuterShellButton" Style="{StaticResource ToolAction}" Content="◫" Click="OuterShell_Click"
                        ToolTip="Buitenschil (Outer Shell): alle delen die elkaar overlappen of met een vlak raken, in één keer samenvoegen. (Platte en ronde vlakken: cilinders, kegels, bollen, ringen; nog geen vrije vormen.)"/>
                <RadioButton x:Name="UnionTool" Style="{StaticResource Tool}" Content="∪" Checked="Tool_Checked"
                             ToolTip="Verenigen (Union): klik een deel, klik een tweede deel dat het overlapt of met een vlak raakt: ze worden één. (Platte en ronde vlakken: cilinders, kegels, bollen, ringen; nog geen vrije vormen.)"/>
                <RadioButton x:Name="SubtractTool" Style="{StaticResource Tool}" Content="∖" Checked="Tool_Checked"
                             ToolTip="Aftrekken (Subtract): klik het deel waar iets af moet, klik het deel dat eraf gaat (dat verdwijnt). (Platte en ronde vlakken: cilinders, kegels, bollen, ringen; nog geen vrije vormen.)"/>
                <RadioButton x:Name="IntersectTool" Style="{StaticResource Tool}" Content="∩" Checked="Tool_Checked"
                             ToolTip="Doorsnede (Intersect): klik een deel en een tweede dat het overlapt: alleen wat ze gemeen hebben blijft over. (Platte en ronde vlakken: cilinders, kegels, bollen, ringen; nog geen vrije vormen.)"/>
                <RadioButton x:Name="TrimTool" Style="{StaticResource Tool}" Content="✂" Checked="Tool_Checked"
                             ToolTip="Wegsnijden (Trim): klik het deel dat bijgesneden wordt, klik het deel dat snijdt (dat blijft staan). (Platte en ronde vlakken: cilinders, kegels, bollen, ringen; nog geen vrije vormen.)"/>
                <RadioButton x:Name="SplitTool" Style="{StaticResource Tool}" Content="⊘" Checked="Tool_Checked"
                             ToolTip="Splitsen (Split): klik twee delen die elkaar overlappen: ze worden drie delen (alleen het eerste, het gemeenschappelijke, alleen het tweede). (Platte en ronde vlakken: cilinders, kegels, bollen, ringen; nog geen vrije vormen.)"/>
                <TextBlock Style="{StaticResource ToolGroup}" Text="METEN EN AANTEKENEN"/>
                <RadioButton x:Name="TapeTool" Style="{StaticResource Tool}" Content="📏" Checked="Tool_Checked"
                             ToolTip="Meetlint (T): klik een punt en beweeg om te meten; klik een rand en trek eraf voor een hulplijn (of typ de afstand + Enter). Delete: alle hulplijnen weg."/>
                <RadioButton x:Name="DimensionTool" Style="{StaticResource Tool}" Content="↔" Checked="Tool_Checked"
                             ToolTip="Maatlijn (Dimensions): klik twee punten (vastklikken op hoeken en randen), beweeg om de maatlijn ervan af te zetten en klik. Klik een maat om hem weg te halen. Alleen in beeld."/>
                <RadioButton x:Name="ProtractorTool" Style="{StaticResource Tool}" Content="∡" Checked="Tool_Checked"
                             ToolTip="Gradenboog (Protractor): klik het middelpunt op een vlak, klik een punt voor de beginlijn, beweeg voor de hoek (stappen van 15°) en klik; of typ de hoek + Enter. Er komt een hulplijn onder die hoek."/>
                <RadioButton x:Name="AxesTool" Style="{StaticResource Tool}" Content="✛" Checked="Tool_Checked"
                             ToolTip="Assen (Axes): klik een nieuwe oorsprong, klik een punt in de richting van de rode as en een punt voor de groene as: vastklikken, rechthoeken en de pijltjes volgen die assen. Klik op een lege plek: de gewone assen terug."/>
                <RadioButton x:Name="TextTool" Style="{StaticResource Tool}" Content="💬" Checked="Tool_Checked"
                             ToolTip="Tekstlabel (Text): klik een punt op het model, typ de tekst en druk op Enter. Klik een label om het weg te halen. Alleen in beeld."/>
                <RadioButton x:Name="SectionTool" Style="{StaticResource Tool}" Content="⊟" Checked="Tool_Checked"
                             ToolTip="Doorsnedevlak (Section Plane): klik een plat vlak, beweeg om het snijvlak het model in te schuiven en klik (of typ de diepte + Enter): alles ervoor wordt weggelaten, de snijlijn dik getekend. Esc (met ⊟ gekozen): weg ermee."/>
                <RadioButton x:Name="TagTool" Style="{StaticResource Tool}" Content="🏷" Checked="Tool_Checked"
                             ToolTip="Verbergen (Tag): klik een deel om het te verbergen (bv. om erachter te werken); klik op een lege plek om alles weer te tonen. Alleen in beeld."/>
                <RadioButton x:Name="Text3DTool" Style="{StaticResource Tool}" Content="A" Checked="Tool_Checked"
                             ToolTip="3D-tekst (3D Text): klik een punt op een plat vlak, typ de tekst en druk op Enter: de letters worden vlakken (zo hoog als de maat in het vak, standaard een vijfde van het vlak). Typ daarna een dikte + Enter om ze er allemaal uit te trekken."/>
                <TextBlock Style="{StaticResource ToolGroup}" Text="KLEUR, SELECTIE EN GUM"/>
                <RadioButton x:Name="PaintTool" Style="{StaticResource Tool}" Content="🎨" Checked="Tool_Checked"
                             ToolTip="Verfemmer (B): kies een kleur en klik een vlak. Ctrl: het hele lichaam · Shift: alle vlakken in dezelfde kleur · Alt: kleur overnemen."/>
                <Button x:Name="SampleButton" Style="{StaticResource ToolAction}" Content="💧" Click="SampleButton_Click" ToolTip="Pipet (Sample Material): klik een vlak om zijn kleur over te nemen in de verfemmer (ook: Alt+klik met de verfemmer)"/>
                <RadioButton x:Name="LassoTool" Style="{StaticResource Tool}" Content="➰" Checked="Tool_Checked"
                             ToolTip="Lasso: klik, trek een lus om vlakken heen en klik nog eens: die vlakken zijn gekozen (Shift: erbij, Ctrl: eraf). Daarna verplaatst ✥ ze samen en verft 🎨 ze in één keer. Esc: keuze leeg."/>
                <RadioButton x:Name="EraserTool" Style="{StaticResource Tool}" Content="⌫" Checked="Tool_Checked"
                             ToolTip="Gum (E): klik een getekende lijn, rechthoek of cirkel weg; de vlakken worden weer één."/>
                <TextBlock Style="{StaticResource ToolGroup}" Text="KIJKEN"/>
                <Button x:Name="ZoomExtentsButton" Style="{StaticResource ToolAction}" Content="⛶" Click="ZoomExtentsButton_Click" ToolTip="Alles in beeld (Zoom Extents)"/>
                <RadioButton x:Name="ZoomTool" Style="{StaticResource Tool}" Content="🔍" Checked="Tool_Checked"
                             ToolTip="Zoomen (Zoom): klik, beweeg omhoog om in te zoomen of omlaag om uit te zoomen, klik om te stoppen. (Het wieltje zoomt ook.)"/>
                <RadioButton x:Name="ZoomWindowTool" Style="{StaticResource Tool}" Content="🔎" Checked="Tool_Checked"
                             ToolTip="Zoomvenster (Zoom Window): klik een hoek, klik de andere hoek: wat in het kader staat, vult het beeld."/>
                <RadioButton x:Name="PositionCameraTool" Style="{StaticResource Tool}" Content="📷" Checked="Tool_Checked"
                             ToolTip="Camera plaatsen (Position Camera): klik waar je wilt staan (op een vlak of de grond); je kijkt vanaf ooghoogte. Typ een andere ooghoogte (mm) + Enter. Daarna rondkijken."/>
                <RadioButton x:Name="LookAroundTool" Style="{StaticResource Tool}" Content="👁" Checked="Tool_Checked"
                             ToolTip="Rondkijken (Look Around): klik en beweeg om je hoofd te draaien zonder van je plek te gaan; klik om te stoppen."/>
                <RadioButton x:Name="WalkTool" Style="{StaticResource Tool}" Content="🚶" Checked="Tool_Checked"
                             ToolTip="Lopen (Walk): ↑/↓ vooruit en achteruit, ←/→ draaien, PageUp/PageDown omhoog en omlaag; klik en beweeg om rond te kijken."/>
            </WrapPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="StructureLeft" Grid.Row="1" Style="{StaticResource Card}" Padding="10,8,6,8" Margin="0,12,0,0" Width="229" MinHeight="44"
                VerticalAlignment="Stretch"/>
        </Grid>

        <!-- ============================== the structure tree (when it is on the right) -->
        <Border x:Name="StructureRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="10,8,6,8" Margin="12,0,0,0" Width="250"
                Visibility="Collapsed"/>

        <!-- ============================== the view -->
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="22" Background="{StaticResource ViewGradient}" Effect="{StaticResource Shadow}" ClipToBounds="True">
            <Grid>
                <!-- DirectX 11 (HelixToolkit.Wpf.SharpDX): the faces, their edges and what is drawn; the camera is steered by
                     this window alone (the viewer's own camera control, with its gliding on, is off): the middle button
                     turns, Shift + middle button pans, the wheel zooms -->
                <hx:Viewport3DX x:Name="View" Margin="6" BackgroundColor="#F2F7FD"
                                ShowViewCube="True" ShowCoordinateSystem="False" IsRotationEnabled="False" ModelUpDirection="0,0,1"
                                UseDefaultGestures="False" IsPanEnabled="False" IsZoomEnabled="False" IsMoveEnabled="False"
                                IsChangeFieldOfViewEnabled="False" IsInertiaEnabled="False" MSAA="Eight"
                                PreviewMouseWheel="View_PreviewMouseWheel"
                                PreviewMouseDown="View_PreviewMouseDown" PreviewMouseMove="View_PreviewMouseMove" PreviewMouseUp="View_PreviewMouseUp"
                                PreviewMouseLeftButtonDown="View_MouseLeftButtonDown" MouseMove="View_MouseMove" MouseLeave="View_MouseLeave">
                    <hx:Viewport3DX.Camera>
                        <hx:PerspectiveCamera Position="150,-200,150" LookDirection="-150,200,-150" UpDirection="0,0,1"
                                              FieldOfView="45" NearPlaneDistance="1" FarPlaneDistance="20000"/>
                    </hx:Viewport3DX.Camera>
                    <hx:AmbientLight3D Color="#84848C"/>
                    <!-- (a head light: turned with the camera) -->
                    <hx:DirectionalLight3D x:Name="HeadLight" Color="#8E8E8E" Direction="-1,1,-1"/>
                    <hx:GroupModel3D x:Name="ModelHost"/>
                    <hx:GroupModel3D x:Name="HighlightHost"/>
                </hx:Viewport3DX>

                <!-- while a work plane is set: back to the ground in one click -->
                <Button x:Name="GroundButton" Content="⊞  grond" Style="{StaticResource PillButton}" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Click="GroundButton_Click"
                        ToolTip="Werkvlak terug op de grond (net als ⊞ en klikken op een lege plek)"/>

                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="🧊" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sleep een STL, 3MF of .rsdocx hierheen" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="middelste knop = draaien · Shift + middelste knop = schuiven · wiel = zoomen" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- busy -->
                <Border x:Name="Busy" Visibility="Collapsed" Background="#AAF3F6FB">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="44" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BusyText" Text="Vormen herkennen…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- the radius of a rounding, pin or hole, next to it (as DesignSpark) -->
                <Canvas x:Name="TagLayer" IsHitTestVisible="False">
                    <Polyline x:Name="LassoLine" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="4 3" Visibility="Collapsed"/>
                    <Border x:Name="RadiusTag" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                            CornerRadius="8" Padding="8,3">
                        <TextBlock x:Name="RadiusTagText" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}"/>
                    </Border>
                </Canvas>

                <!-- the paint bucket's palette -->
                <Border x:Name="PaintPanel" Visibility="Collapsed" Style="{StaticResource Card}" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="16" Padding="12,10" Width="232">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🎨 Verf" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <TextBlock x:Name="PaintName" Margin="8,0,0,0" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <WrapPanel x:Name="Swatches"/>
                    </StackPanel>
                </Border>

                <!-- toast -->
                <Border x:Name="Toast" Visibility="Collapsed" Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,16,0,0" Padding="18,12" MaxWidth="560">
                    <StackPanel>
                        <TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== status bar: what to do, and the measurements box -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Padding="14,6" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="AssistantBox" Content="🤖 AI-assistent mag meewerken" IsChecked="False" VerticalAlignment="Center" Margin="0,0,16,0"
                              Foreground="{StaticResource Muted}" Click="AssistantBox_Click"
                              ToolTip="Aan: een AI-assistent (via MCP, bijvoorbeeld Claude Code, Claude Desktop of VS Code) mag in dit venster meewerken: het model bekijken en bewerken. Alles wat hij doet zie je hier en kun je ongedaan maken. Zie de README voor het koppelen."/>
                    <CheckBox x:Name="JoinBox" Content="samenvoegen" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                              Foreground="{StaticResource Muted}" Click="JoinBox_Click"
                              ToolTip="Aan: wat je met ⇕ tegen een ander deel aan trekt, wordt er één deel mee (zoals DesignSpark). Uit: het blijft een apart deel."/>
                    <TextBlock x:Name="MeasureLabel" Text="Afstand" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <TextBox x:Name="MeasureBox" Width="110" FontSize="15" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" IsReadOnly="True" Focusable="False" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="MeasureUnit" Text="mm" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="13.5" TextWrapping="Wrap" Margin="4,0,16,0"
                       Text="Open een model om te beginnen."/>
        </DockPanel>
    </Grid>
</Window>
