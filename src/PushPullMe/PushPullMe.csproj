<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop app, for Windows, Linux and macOS: a window around the shared view (PushPullMe.App), with what only
       the desktop has (file paths, dialog windows, the converter's window, the MCP pipe). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the icon (Assets/pushpullme.ico, after the user's design; drawn by tools/icon.py) -->
    <ApplicationIcon>Assets\pushpullme.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- recognising a mesh runs its bodies in parallel (as in the converter) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- (the MCP server comes along through the editor layer, built with and without a runtime: the same two small files) -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PushPullMe.App\PushPullMe.App.csproj" />
    <!-- the converter's window, opened here for a mesh (STL/3MF); its result is taken over in memory -->
    <ProjectReference Include="$(RsConverterDir)tools\StlConverter\StlConverter.csproj" />
  </ItemGroup>

</Project>
