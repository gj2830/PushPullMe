<Project Sdk="Microsoft.NET.Sdk">

  <!-- The window, for Windows, Linux and macOS (Avalonia, 3D through OpenGL): it shows what the editor layer
       (PushPullMe.Editor) describes and passes the mouse and the keys on to it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the icon (Assets/pushpullme.ico, after the user's design; drawn by tools/icon.py) -->
    <ApplicationIcon>Assets\pushpullme.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- (vertex data handed to OpenGL by pointer) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- recognising a mesh runs its bodies in parallel (as in the converter) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- (the MCP server comes along through the editor layer, built with and without a runtime: the same two small files) -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\pushpullme.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PushPullMe.Core\PushPullMe.Core.csproj" />
    <ProjectReference Include="..\PushPullMe.Editor\PushPullMe.Editor.csproj" />
    <!-- the converter's window, opened here for a mesh (STL/3MF); its result is taken over in memory -->
    <ProjectReference Include="$(RsConverterDir)tools\StlConverter\StlConverter.csproj" />
  </ItemGroup>

</Project>
